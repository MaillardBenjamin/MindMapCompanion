DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/personal_assistant

# Configuration JWT
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXP_MINUTES=1440

# Configuration d'authentification
AUTH_USERNAME=admin
AUTH_PASSWORD=admin

# Configuration Email (IMAP/SMTP)
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=user@example.com
IMAP_PASSWORD=your-app-password
IMAP_FOLDER=INBOX
IMAP_SSL=true
IMAP_POLL_MINUTES=2

# Configuration des agents IA
AGNO_MODEL=gpt-4o-mini
AGNO_API_KEY=your-agno-api-key
OPENAI_API_KEY=your-openai-api-key
MISTRAL_API_KEY=your-mistral-api-key

# Configuration des APIs de recherche web
GOOGLE_SEARCH_API_KEY=your-google-search-api-key
GOOGLE_SEARCH_ENGINE_ID=your-google-search-engine-id
BING_SEARCH_API_KEY=your-bing-search-api-key
SEARCH_PROVIDER=google

# Configuration CORS
CORS_ORIGINS=http://localhost:5173