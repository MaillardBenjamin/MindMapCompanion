DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/personal_assistant

# Configuration JWT
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXP_MINUTES=1440

# Configuration d'authentification
AUTH_USERNAME=admin
AUTH_PASSWORD=admin

# Configuration Email (IMAP/SMTP)
# Utilisé aussi pour l’envoi d’alertes (agent « supervision site ») : même hôte en SMTP:587 + STARTTLS
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=user@example.com
IMAP_PASSWORD=your-app-password
IMAP_FOLDER=INBOX
IMAP_SSL=true
IMAP_POLL_MINUTES=2

# Configuration des agents IA
# Désactiver l'appel LLM (pour mise au point scraping, évite les coûts)
SKIP_AGENT_LLM=false
# Supervision site : nb max de tours « auto-correction » du plan après échec Playwright (LLM). 0 = désactivé
SITE_HEALTH_MAX_REPAIRS=2
# Capture d’écran PNG quand une étape Playwright échoue (auto-correction guidée par vision)
SITE_HEALTH_FAILURE_SCREENSHOT=true
# Envoyer cette capture au modèle lors de la réparation (false si pas de vision côté API)
SITE_HEALTH_REPAIR_WITH_SCREENSHOT=true
AGNO_MODEL=gpt-4o-mini
AGNO_API_KEY=your-agno-api-key
OPENAI_API_KEY=your-openai-api-key
MISTRAL_API_KEY=your-mistral-api-key
# Ollama (modèle local) : si défini, remplace OpenAI. Ex: http://localhost:11434/v1 avec AGNO_MODEL=qwen3:14b
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Configuration des APIs de recherche web
GOOGLE_SEARCH_API_KEY=your-google-search-api-key
GOOGLE_SEARCH_ENGINE_ID=your-google-search-engine-id
BING_SEARCH_API_KEY=your-bing-search-api-key
SEARCH_PROVIDER=google

# Configuration CORS
CORS_ORIGINS=http://localhost:5173

# GitHub API (optionnel : dépôts privés, quota API)
# GITHUB_TOKEN=